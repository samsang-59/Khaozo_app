# Copy to .env.local. Only VITE_* variables reach the browser — never put secrets here.
# Same Web client ID as the backend's GOOGLE_CLIENT_ID (add http://localhost:5173 to its
# Authorised JavaScript origins in Google Cloud Console).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Production only: where the API lives when it isn't proxied (e.g. https://api.khaozo.in).
# Leave empty in development — Vite proxies /api and /socket.io to localhost:3000.
VITE_API_URL=
