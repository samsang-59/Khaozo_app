{
  "info": {
    "name": "Khaozo API",
    "description": "Manual checks per phase (regression gate, 07_testing_plan.md). Base URL in the collection variable baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" }
  ],
  "item": [
    {
      "name": "Phase 0 — System",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 + db/redis ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data).to.eql({ status: 'ok', db: 'ok', redis: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route → 404",
          "request": { "method": "GET", "url": "{{baseUrl}}/does-not-exist" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 ROUTE_NOT_FOUND', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('ROUTE_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
