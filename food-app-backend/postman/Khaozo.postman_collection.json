{
  "info": {
    "name": "Khaozo API",
    "description": "Manual checks per phase (regression gate, 07_testing_plan.md). Base URL in the collection variable baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "googleIdToken",
      "value": "paste the ID token from /dev/google-login"
    },
    {
      "key": "placeId",
      "value": "1"
    },
    {
      "key": "menuItemId",
      "value": "1"
    },
    {
      "key": "ratingId",
      "value": "1"
    },
    {
      "key": "reviewId",
      "value": "1"
    },
    {
      "key": "standardDishId",
      "value": "1"
    },
    {
      "key": "groupCode",
      "value": "ABC234"
    },
    {
      "key": "guestPass",
      "value": ""
    },
    {
      "key": "adminAccessToken",
      "value": "access token of an admin (npm run make-admin, then log in again)"
    },
    {
      "key": "reportId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Phase 0 — System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 + db/redis ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data).to.eql({ status: 'ok', db: 'ok', redis: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route → 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 ROUTE_NOT_FOUND', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('ROUTE_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Phase 2 — Auth & Me",
      "description": "Get an ID token from http://localhost:3000/dev/google-login, paste it into the googleIdToken variable, then run in order. Postman keeps the refresh cookie (path /api/v1/auth).",
      "item": [
        {
          "name": "Login with Google",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/google",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.success && b.data && b.data.accessToken) pm.collectionVariables.set('accessToken', b.data.accessToken);",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (cookie)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.success && b.data && b.data.accessToken) pm.collectionVariables.set('accessToken', b.data.accessToken);",
                  "pm.test('200 + rotated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
