# Copy to .env and fill in. Secrets live here only — never in the DB.
NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose maps the container to host port 5433)
DATABASE_URL=postgres://khaozo:khaozo@localhost:5433/food_app
TEST_DATABASE_URL=postgres://khaozo:khaozo@localhost:5433/food_app_test

# Redis (test suite uses logical DB 1 so it never touches dev data)
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1
