# Copy to .env and fill in. Secrets live here only — never in the DB.
NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose maps the container to host port 5433)
DATABASE_URL=postgres://khaozo:khaozo@localhost:5433/food_app
TEST_DATABASE_URL=postgres://khaozo:khaozo@localhost:5433/food_app_test

# Redis (test suite uses logical DB 1 so it never touches dev data)
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Auth — Google OAuth Client ID (Google Cloud Console → Credentials, type "Web application")
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Signs access tokens / guest passes. At least 32 random characters, never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# One-time first admin: npm run make-admin sets role = admin for this email (after first login)
ADMIN_EMAIL=you@example.com

# AI — Gemini key from https://aistudio.google.com/apikey (free tier). Never commit it.
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-3.5-flash-lite, gemini-embedding-001 at 768 dims)
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional chat fallback (prepaid) — used only when both are set
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=
